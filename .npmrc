# Dependency lifecycle scripts (preinstall/install/postinstall) are arbitrary
# code from 1490 third-party packages, and CI runs `npm ci` in jobs that hold a
# write-scoped GITHUB_TOKEN (architecture-submission, import-architectures,
# pr-queue-hygiene, create-milestones). Nothing in this project needs them, so
# they are not run. Verified: no package.json lifecycle hooks exist, and only
# three dependencies declare install scripts, none of them load-bearing:
#   - @swc/core        postinstall is an advisory warning only; the native
#                      binding ships prebuilt in @swc/core-linux-x64-gnu, which
#                      declares no install script of its own.
#   - core-js          postinstall prints a funding banner.
#   - fsevents         macOS-only and optional; chokidar falls back without it.
ignore-scripts=true
