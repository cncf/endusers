{
  "name": "endusers",
  "version": "0.9.0",
  "description": "Community resources for CNCF end users.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "_build": "npm run generate:changelog && npm run docus:build",
    "_check:format:any": "npx prettier --check --ignore-path ''",
    "_check:format:delta": "npm run _check:format:any -- $(npm run -s _list:git:delta)",
    "_check:format": "npx prettier --check .",
    "_check:links-md": "npm run -s _list:check:md | xargs -I {} -P 4 npx markdown-link-check --config .markdown-link-check.json -p -v {}",
    "_check:links-data": "node scripts/check-data-links.mjs",
    "_check:links": "npm run _check:links-md && npm run _check:links-data",
    "_check:markdown:all": "npm run -s _list:check:md | xargs -I {} -P 4 npx -p markdownlint-cli markdownlint -c .markdownlint.yaml {}",
    "_check:markdown:delta": "npm run -s _list:git:delta | xargs -I {} npx -p markdownlint-cli markdownlint -c .markdownlint.yaml {}",
    "_list:check:*": "npm run --loglevel=warn | grep -Ee '^\\s*check:[^:]+$'",
    "_list:check:md:no-analysis": "find . -name '*.md' -not -path '*/node_modules/*' -a -not -path '*/.?*' -a -not -path '*/00*'",
    "_list:check:md": "find . -name '*.md' -not -path '*/node_modules/*' -a \\( -not -path '*/.?*' -o -path './.github/*' -o -path './.agents/*' \\)",
    "_list:fix:*": "npm run --loglevel=warn | grep -Ee '^\\s*fix:[^:]+$' | grep -v 'fix:all'",
    "_list:git:delta": "git diff --name-only --diff-filter=ACMR | grep -E '\\.(js|md|scss|yml|yaml)$'",
    "build:preview": "npm run _build",
    "build:production": "npm run _build",
    "build:netlify": "node scripts/netlify-build.mjs",
    "build": "BUILD_ENV=dev npm run _build",
    "check:audit": "node scripts/audit-gate.mjs",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:format": "npm run _check:format || (echo '[help] Run: npm run fix:format'; exit 1)",
    "check:links": "npm run _check:links",
    "check:lint": "eslint --max-warnings 0 .",
    "check:markdown": "npm run _check:markdown:all",
    "check:unused": "knip --no-progress",
    "check:spelling": "npx cspell --no-progress -c .cspell.yml docs blog adr '.github/**/*.md' '.agents/**/*.md' *.md",
    "check": "npm run seq -- $(npm run -s _list:check:*)",
    "docus:build": "docusaurus build",
    "docus:clear": "docusaurus clear",
    "docus:deploy": "docusaurus deploy",
    "docus:serve": "docusaurus serve",
    "docus:start": "docusaurus start",
    "docus:swizzle": "docusaurus swizzle",
    "docus:write-heading-ids": "docusaurus write-heading-ids",
    "docus:write-translations": "docusaurus write-translations",
    "collect:enduser-members": "node scripts/collect-enduser-members.mjs",
    "import:architecture-issue": "node scripts/import-architecture-issue.mjs",
    "fetch:community-people": "node scripts/fetch-community-people.mjs",
    "check:community-group-links": "node scripts/check-community-group-links.mjs",
    "generate:changelog": "node scripts/generate-changelog.mjs",
    "generate:members": "node scripts/generate-members.mjs && node scripts/validate-members.mjs",
    "validate:architectures": "node scripts/validate-architectures.mjs",
    "validate:architecture-assets": "node scripts/validate-architecture-assets.mjs",
    "validate:button-contrast": "node scripts/validate-button-contrast.mjs",
    "validate:awards": "node scripts/validate-awards.mjs",
    "validate:enduser-members": "node scripts/validate-enduser-members.mjs",
    "validate:members": "node scripts/validate-members.mjs",
    "docusaurus": "docusaurus",
    "fix:format": "npm run _check:format -- --write",
    "fix": "npm run seq -- $(npm -s run _list:fix:*)",
    "seq": "bash -c 'for cmd in \"$@\"; do npm run $cmd || exit 1; done' - ",
    "serve": "npm run docus:serve",
    "test": "npm run check && npm run test:unit",
    "update:pkgs": "npx npm-check-updates -u",
    "collect:metrics": "node scripts/collect-metrics.mjs",
    "validate:metrics": "node scripts/validate-metrics.mjs",
    "collect:case-studies": "node scripts/collect-case-studies.mjs",
    "validate:case-studies": "node scripts/validate-case-studies.mjs",
    "collect:radar-reports": "node scripts/collect-radar-reports.mjs",
    "collect:end-user-talks": "node scripts/collect-end-user-talks.mjs",
    "validate:radar-reports": "node scripts/validate-radar-reports.mjs",
    "validate:community-people": "node scripts/validate-community-people.mjs",
    "validate:community-groups": "node scripts/validate-community-groups.mjs",
    "validate:projects-born": "node scripts/validate-projects-born.mjs",
    "validate:end-user-talks": "node scripts/validate-end-user-talks.mjs",
    "validate:all": "npm run validate:metrics && npm run validate:architectures && npm run validate:architecture-assets && npm run validate:awards && npm run validate:community-people && npm run validate:community-groups && npm run validate:case-studies && npm run validate:radar-reports && npm run validate:projects-born && npm run validate:end-user-talks && npm run validate:button-contrast && npm run validate:enduser-members && npm run validate:members",
    "pr-queue-hygiene": "node scripts/pr-queue-hygiene.mjs",
    "test:unit": "TZ=UTC node --test",
    "test:unit:coverage": "TZ=UTC node tests/tools/coverage-report.mjs",
    "test:unit:coverage:check": "TZ=UTC node tests/tools/coverage-report.mjs --check 99 --check-source 100 --check-regions 96 --check-source-regions 100 --check-source-file-regions 100 --check-harness 100 --check-harness-regions 99 --check-harness-file-regions 98 --require-source-files",
    "test:e2e": "playwright test",
    "test:mutation": "TZ=UTC stryker run",
    "build:e2e:coverage": "npm run build:e2e:coverage:site && npm run build:e2e:coverage:fixtures",
    "build:e2e:coverage:site": "DOCUSAURUS_NO_PERSISTENT_CACHE=1 E2E_COVERAGE=1 npm run build:production",
    "build:e2e:coverage:fixtures": "node tests/tools/e2e-coverage-builds.mjs",
    "test:e2e:coverage": "E2E_COVERAGE=1 playwright test",
    "report:e2e:coverage": "node tests/tools/e2e-coverage-report.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cncf/endusers.git"
  },
  "author": "CNCF",
  "license": "CC-BY-4.0",
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/utils": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "css-tree": "^3.2.1",
    "docusaurus-plugin-search-local": "^2.1.2",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/mdx-loader": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "^9.39.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@mdx-js/mdx": "^3.1.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/tap-runner": "^10.0.0",
    "@swc/core": "1.16.18",
    "@swc/core-linux-x64-gnu": "1.16.18",
    "cspell": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jscpd": "^5.4.1",
    "knip": "^6.42.1",
    "markdown-link-check": "3.15.0",
    "markdownlint-cli": "^0.49.1",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "smol-toml": "^1.9.1",
    "typescript": "~7.0.2",
    "v8-to-istanbul": "^9.3.0",
    "yaml": "^2.9.1"
  },
  "private": true,
  "spelling": "cSpell:ignore ACMR docus HTMLTEST loglevel pkgs -",
  "prettier": {
    "proseWrap": "always",
    "singleQuote": true
  },
  "homepage": "https://endusers.cncf.io/",
  "overrides": {
    "basic-ftp": "^6.2.1",
    "serialize-javascript": "^7.1.3",
    "picomatch": "^2.3.2",
    "shell-quote": "^1.11.0",
    "joi": "^17.13.8",
    "qs": "^6.16.0",
    "body-parser": "^1.20.9",
    "undici": "^7.30.1",
    "fast-uri": "^3.1.9",
    "webpack-dev-middleware": "^7.4.6",
    "ajv@8": "^8.18.0",
    "ajv@6": "^6.14.0",
    "cspell-glob": {
      "picomatch": "^4.0.4"
    },
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "markdownlint-cli": {
      "js-yaml": "5.4.2",
      "smol-toml": "^1.9.0"
    },
    "tinypool": "^2.1.2",
    "postcss-selector-parser": "^7.1.6",
    "micromark-extension-math": {
      "katex": "^0.18.2"
    }
  }
}
